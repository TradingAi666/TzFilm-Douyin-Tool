# Copy this file to ~/.codex/douyin-tool/.env and fill in real values.

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_HOME_CHANNEL=

# Notion sync
NOTION_TOKEN=
NOTION_SOURCE_OVERVIEW=
NOTION_SOURCE_TRACKING=
NOTION_SOURCE_ACCOUNT=

# Optional: override Notion key field names when your database columns differ.
# Defaults:
# - overview key: 文本
# - tracking key: 多行文本
# - account key: 多行文本
# NOTION_KEY_OVERVIEW=文本
# NOTION_KEY_TRACKING=多行文本
# NOTION_KEY_ACCOUNT=多行文本

# Optional: override default database path.
# DOUYIN_DB_PATH=/Users/may22/.codex/douyin-tool/douyin_stats.db
